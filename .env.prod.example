# ==============================================================================
# ms-eventomax-bff — Production Environment Template (.env.prod.example)
# ==============================================================================

# Microsoft Entra ID — JWT validation
ENTRA_ISSUER_URI=https://login.microsoftonline.com/<TENANT_ID>/v2.0
ENTRA_AUDIENCE=api://<BACKEND_API_CLIENT_ID>

# Downstream microservices (Docker network names on eventomax-net)
PRODUCTIONS_BASE_URL=http://ms-eventomax-productions:8080
CATALOG_BASE_URL=http://ms-eventomax-catalog:8080
REPORT_BASE_URL=http://ms-eventomax-report:8080
AUDIT_BASE_URL=http://ms-eventomax-audit:8080
NOTIFY_BASE_URL=http://ms-eventomax-notify:8080
RABBIT_ADMIN_BASE_URL=http://ms-eventomax-rabbit-admin:8080

# Downstream HTTP client timeouts
DOWNSTREAM_CONNECT_TIMEOUT=3s
DOWNSTREAM_READ_TIMEOUT=10s

# JVM Memory Budget (Container mem_limit: 640m)
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=25.0 -XX:MaxRAMPercentage=65.0 -XX:+ExitOnOutOfMemoryError
